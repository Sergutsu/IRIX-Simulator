{
  "name": "irix-65-simulator",
  "private": true,
  "version": "6.5.22",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/smoke.cjs && node node_modules/.cache/smoke.cjs",
    "check:render": "esbuild scripts/ssr.ts --bundle --platform=node --format=cjs --loader:.css=text --outfile=node_modules/.cache/ssr.cjs && node node_modules/.cache/ssr.cjs",
    "test": "npm run smoke && npm run check:render"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
